{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/go", "destination": "/api/go" },
    { "source": "/buy", "destination": "/api/go" }
  ],
  "headers": [
    { "source": "/(.*)\\.(jpg|png|webp|svg|ico)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
